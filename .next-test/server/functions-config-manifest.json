{
  "version": 1,
  "functions": {
    "/_middleware": {
      "runtime": "nodejs",
      "matchers": [
        {
          "regexp": "^(?:\\/(_next\\/data\\/[^/]{1,}))?(?:\\/((?!_next\\/|images\\/|favicon|robots.txt|sitemap.xml|.*\\.[a-zA-Z0-9]+$).*))(\\.json|\\.rsc|\\.segments\\/.+\\.segment\\.rsc)?[\\/#\\?]?$",
          "originalSource": "/((?!_next/|images/|favicon|robots.txt|sitemap.xml|.*\\.[a-zA-Z0-9]+$).*)"
        }
      ]
    }
  }
}